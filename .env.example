# Recommended for connections between different networks.
# Use credentials from Cloudflare TURN, Metered, or your own Coturn server.
TURN_URLS=turn:your-turn-host.example:3478,turns:your-turn-host.example:5349
TURN_USERNAME=your-username
TURN_CREDENTIAL=your-password

# Alternative providers already supported by /api/ice:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# METERED_TURN_API_KEY=
# METERED_TURN_APP=
